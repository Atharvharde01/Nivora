# Node Environment (REQUIRED): 'development' | 'test' | 'production'
NODE_ENV=development

# Backend Port (OPTIONAL — integer 1–65535, defaults to 3002)
PORT=3002

# MongoDB Connection URI (REQUIRED — must use mongodb:// or mongodb+srv://)
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Frontend & Dashboard Origins (REQUIRED — absolute HTTP/HTTPS origin without path, query, fragment, or credentials)
# Development / Test: http://localhost:3000 and http://localhost:3001
# Production: MUST be non-localhost HTTPS origins (e.g. https://nivora-frontend.vercel.app)
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001
