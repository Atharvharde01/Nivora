# ==============================================================================
# NIVORA BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in development.
# In production (Render), set these environment variables directly in the Render Dashboard.
# NEVER commit the real .env file or production secrets to source control.

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Required: 'development' | 'test' | 'production'
NODE_ENV=development

# Optional: Port number (1–65535, defaults to 5000).
# Render sets the PORT variable automatically in production.
PORT=5000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MONGODB ATLAS)
# ------------------------------------------------------------------------------
# Required: MongoDB connection URI (must use mongodb:// or mongodb+srv://)
# In production, must point to a replica-set cluster (MongoDB Atlas M0+ or dedicated)
# with retryable writes and majority write concern:
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Nivora?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. CORS & ALLOWED CLIENT ORIGINS
# ------------------------------------------------------------------------------
# Required: Absolute HTTP/HTTPS origin without trailing slash, path, or credentials.
# In production, these MUST be non-localhost HTTPS origins.
# Example: FRONTEND_URL=https://app.nivora.in
#          DASHBOARD_URL=https://dashboard.nivora.in
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECRETS
# ------------------------------------------------------------------------------
# Required: Cryptographic HMAC key for OTP generation and verification.
# In production: MUST be a random high-entropy string of at least 32 characters.
OTP_HMAC_SECRET=development_otp_hmac_secret_key_minimum_32_characters_long

# Required: JWT signing secret for 15-minute access tokens.
# In production: MUST be a random high-entropy string of at least 32 characters.
JWT_ACCESS_SECRET=development_jwt_access_secret_key_minimum_32_characters_long

# Optional JWT claims (defaults: issuer="nivora-api", audience="nivora-client")
JWT_ISSUER=nivora-api
JWT_AUDIENCE=nivora-client

# ------------------------------------------------------------------------------
# 5. EMAIL DELIVERY (BREVO / SENDINBLUE)
# ------------------------------------------------------------------------------
# Required in production for delivering 6-digit OTP codes:
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=noreply@nivora.in
BREVO_SENDER_NAME=NIVORA

# ------------------------------------------------------------------------------
# 6. API DOCUMENTATION & SWAGGER UI
# ------------------------------------------------------------------------------
# Optional: 'true' | 'false'
# Automatically enabled in development/test. Defaults to false in production.
# Set to 'true' only if you wish to expose /docs publicly in production.
ENABLE_SWAGGER_UI=false

# ------------------------------------------------------------------------------
# 7. REVERSE PROXY & TRUST PROXY (RENDER / CLOUDFLARE)
# ------------------------------------------------------------------------------
# CRITICAL DEPLOYMENT NOTE:
# Render routes traffic through Cloudflare edge servers and Render load balancers.
# The exact hop count (1, 2, or boolean true) MUST be empirically verified on a
# live Render staging instance by inspecting req.headers['x-forwarded-for'] and
# client IP detection before setting this to anything other than false.
# Defaults to false.
TRUST_PROXY=false
