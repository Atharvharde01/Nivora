# NIVORA Dashboard — Local Development Configuration
# PORT controls the Create React App development server port.
PORT=3001

# REACT_APP_API_URL controls the Backend API server target URL.
REACT_APP_API_URL=http://localhost:5000

# REACT_APP_FRONTEND_URL controls the public Frontend website URL (login/signup).
REACT_APP_FRONTEND_URL=http://localhost:3000
